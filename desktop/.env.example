# 桌面端只读服务器检查需要显式填写连接地址；未配置时保持纯本地模式。
DIARY_API_BASE_URL=
DIARY_API_TIMEOUT=15
# 如公网入口要求 Basic 密码，请填入真实值到本地环境，勿提交。
DIARY_API_PASSWORD=
# 同步状态文件位置；留空时使用 %LOCALAPPDATA%\DiaryPyQt\sync-state.json。
DIARY_SYNC_STATE_PATH=
# 自动同步前的数据库备份目录；留空时使用 %LOCALAPPDATA%\DiaryPyQt\backups。
DIARY_SYNC_BACKUP_DIR=
# 正文自动同步开关；留空表示按界面里的「自动同步日记内容」勾选状态执行。
DIARY_CONTENT_SYNC_ENABLED=
