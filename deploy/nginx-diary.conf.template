server {
    listen 443 ssl http2;
    server_name ${DIARY_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DIARY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DIARY_DOMAIN}/privkey.pem;

    auth_basic "DiaryPyQt";
    auth_basic_user_file /etc/nginx/.htpasswd-diary;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

